<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Primary action button: large, rounded, with icon -->
    <Style x:Key="PrimaryActionButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="24" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
    </Style>

    <!-- Secondary action button: outlined, rounded -->
    <Style x:Key="SecondaryActionButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="22" />
    </Style>

    <!-- Recovery/Link button: text-only -->
    <Style x:Key="TextLinkButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
    </Style>

    <!-- Vault status card -->
    <Style x:Key="VaultStatusCard" TargetType="materialDesign:Card">
        <Setter Property="Padding" Value="24" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3" />
        <Setter Property="UniformCornerRadius" Value="16" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <!-- Status indicator dot -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Page title -->
    <Style x:Key="PageTitle" TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Subtitle / secondary text -->
    <Style x:Key="SubtitleText" TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- Info label -->
    <Style x:Key="InfoLabel" TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Info value -->
    <Style x:Key="InfoValue" TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignBody1TextBlock}">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Recovery key display box -->
    <Style x:Key="RecoveryKeyBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Warning card -->
    <Style x:Key="WarningCard" TargetType="materialDesign:Card">
        <Setter Property="Background" Value="#FFF3E0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="UniformCornerRadius" Value="12" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <!-- Password strength bar -->
    <Style x:Key="StrengthBar" TargetType="Rectangle">
        <Setter Property="Height" Value="4" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
    </Style>

</ResourceDictionary>
