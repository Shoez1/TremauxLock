<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Status colors -->
    <Color x:Key="UnlockedColor">#4CAF50</Color>
    <Color x:Key="LockedColor">#F44336</Color>
    <Color x:Key="EmptyColor">#9E9E9E</Color>
    <Color x:Key="InconsistentColor">#FF9800</Color>
    <Color x:Key="AccentTeal">#009688</Color>

    <SolidColorBrush x:Key="UnlockedBrush" Color="{StaticResource UnlockedColor}" />
    <SolidColorBrush x:Key="LockedBrush" Color="{StaticResource LockedColor}" />
    <SolidColorBrush x:Key="EmptyBrush" Color="{StaticResource EmptyColor}" />
    <SolidColorBrush x:Key="InconsistentBrush" Color="{StaticResource InconsistentColor}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTeal}" />

    <!-- Password strength colors -->
    <SolidColorBrush x:Key="StrengthWeak" Color="#F44336" />
    <SolidColorBrush x:Key="StrengthFair" Color="#FF9800" />
    <SolidColorBrush x:Key="StrengthStrong" Color="#4CAF50" />

</ResourceDictionary>
