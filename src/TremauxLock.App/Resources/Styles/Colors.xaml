<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Status colors - Paleta Hacking/Cybersecurity moderna e suave -->
    <!-- Verde Terminal/Matrix suave -->
    <Color x:Key="UnlockedColor">#10B981</Color>
    <Color x:Key="UnlockedSoftColor">#2010B981</Color>
    
    <!-- Vermelho Cyber Encrypted -->
    <Color x:Key="LockedColor">#F43F5E</Color>
    <Color x:Key="LockedSoftColor">#20F43F5E</Color>
    
    <!-- Cinza Standby -->
    <Color x:Key="EmptyColor">#64748B</Color>
    <Color x:Key="EmptySoftColor">#1864748B</Color>
    
    <!-- Âmbar Anomalia -->
    <Color x:Key="InconsistentColor">#F59E0B</Color>
    <Color x:Key="InconsistentSoftColor">#20F59E0B</Color>
    
    <!-- Acentos Cyber Hacking -->
    <Color x:Key="CyberCyan">#06B6D4</Color>
    <Color x:Key="CyberCyanSoft">#2006B6D4</Color>
    <Color x:Key="CyberViolet">#8B5CF6</Color>
    <Color x:Key="CyberVioletSoft">#208B5CF6</Color>

    <SolidColorBrush x:Key="UnlockedBrush" Color="{StaticResource UnlockedColor}" />
    <SolidColorBrush x:Key="UnlockedSoftBrush" Color="{StaticResource UnlockedSoftColor}" />
    
    <SolidColorBrush x:Key="LockedBrush" Color="{StaticResource LockedColor}" />
    <SolidColorBrush x:Key="LockedSoftBrush" Color="{StaticResource LockedSoftColor}" />
    
    <SolidColorBrush x:Key="EmptyBrush" Color="{StaticResource EmptyColor}" />
    <SolidColorBrush x:Key="EmptySoftBrush" Color="{StaticResource EmptySoftColor}" />
    
    <SolidColorBrush x:Key="InconsistentBrush" Color="{StaticResource InconsistentColor}" />
    <SolidColorBrush x:Key="InconsistentSoftBrush" Color="{StaticResource InconsistentSoftColor}" />
    
    <SolidColorBrush x:Key="CyberCyanBrush" Color="{StaticResource CyberCyan}" />
    <SolidColorBrush x:Key="CyberCyanSoftBrush" Color="{StaticResource CyberCyanSoft}" />
    <SolidColorBrush x:Key="CyberVioletBrush" Color="{StaticResource CyberViolet}" />
    <SolidColorBrush x:Key="CyberVioletSoftBrush" Color="{StaticResource CyberVioletSoft}" />

    <!-- Força de senha -->
    <SolidColorBrush x:Key="StrengthWeak" Color="#F43F5E" />
    <SolidColorBrush x:Key="StrengthFair" Color="#F59E0B" />
    <SolidColorBrush x:Key="StrengthStrong" Color="#10B981" />
    <SolidColorBrush x:Key="StrengthEmptyBrush" Color="#30718096" />

    <!-- Divisores e bordas garantidos para o tema -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Divider" Color="#20808080" />
    <SolidColorBrush x:Key="BorderDividerBrush" Color="#20808080" />

    <!-- Superfícies sutis -->
    <SolidColorBrush x:Key="SoftBackgroundLight" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SoftBackgroundDark" Color="#0B0F17" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#22FFFFFF" />
</ResourceDictionary>
