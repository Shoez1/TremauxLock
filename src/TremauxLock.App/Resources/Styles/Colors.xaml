<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Status colors - tons modernos e suaves -->
    <Color x:Key="UnlockedColor">#10B981</Color>
    <Color x:Key="UnlockedSoftColor">#1510B981</Color>
    
    <Color x:Key="LockedColor">#EF4444</Color>
    <Color x:Key="LockedSoftColor">#15EF4444</Color>
    
    <Color x:Key="EmptyColor">#64748B</Color>
    <Color x:Key="EmptySoftColor">#1564748B</Color>
    
    <Color x:Key="InconsistentColor">#F59E0B</Color>
    <Color x:Key="InconsistentSoftColor">#15F59E0B</Color>
    
    <!-- Accent colors -->
    <Color x:Key="AccentIndigo">#6366F1</Color>
    <Color x:Key="AccentIndigoDark">#4F46E5</Color>
    <Color x:Key="AccentIndigoSoft">#1A6366F1</Color>

    <SolidColorBrush x:Key="UnlockedBrush" Color="{StaticResource UnlockedColor}" />
    <SolidColorBrush x:Key="UnlockedSoftBrush" Color="{StaticResource UnlockedSoftColor}" />
    
    <SolidColorBrush x:Key="LockedBrush" Color="{StaticResource LockedColor}" />
    <SolidColorBrush x:Key="LockedSoftBrush" Color="{StaticResource LockedSoftColor}" />
    
    <SolidColorBrush x:Key="EmptyBrush" Color="{StaticResource EmptyColor}" />
    <SolidColorBrush x:Key="EmptySoftBrush" Color="{StaticResource EmptySoftColor}" />
    
    <SolidColorBrush x:Key="InconsistentBrush" Color="{StaticResource InconsistentColor}" />
    <SolidColorBrush x:Key="InconsistentSoftBrush" Color="{StaticResource InconsistentSoftColor}" />
    
    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigo}" />
    <SolidColorBrush x:Key="AccentIndigoDarkBrush" Color="{StaticResource AccentIndigoDark}" />
    <SolidColorBrush x:Key="AccentIndigoSoftBrush" Color="{StaticResource AccentIndigoSoft}" />

    <!-- Password strength colors -->
    <SolidColorBrush x:Key="StrengthWeak" Color="#EF4444" />
    <SolidColorBrush x:Key="StrengthFair" Color="#F59E0B" />
    <SolidColorBrush x:Key="StrengthStrong" Color="#10B981" />

    <!-- Neutral soft backgrounds -->
    <SolidColorBrush x:Key="SoftBackgroundLight" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SoftBackgroundDark" Color="#1E293B" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1F000000" />
</ResourceDictionary>
