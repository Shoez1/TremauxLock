<Window x:Class="TremauxLock.App.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:TremauxLock.App.Converters"
        Title="TremauxLock // Ofuscação de Dados"
        Width="480" SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
    </Window.Resources>

    <Grid Margin="24,20,24,24">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ── FASE 1: ENTRADA DE SENHA (visível quando ShowPasswordEntry) ─ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <StackPanel Visibility="{Binding ShowPasswordEntry, Converter={StaticResource BoolToVis}}">

            <!-- Header com badge circular e título -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource CyberCyanSoftBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ShieldLockOutline"
                                             Width="24" Height="24"
                                             Foreground="{DynamicResource CyberCyanBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ofuscação Criptográfica"
                               Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Aplique criptografia militar autenticada AES-256 GCM sobre o payload"
                               Style="{StaticResource SubtitleText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Card dos campos de senha com bordas arredondadas suaves -->
            <materialDesign:Card UniformCornerRadius="18"
                                 Padding="20"
                                 Margin="0,0,0,16"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>

                    <!-- Header da caixa com botão de gerar senha -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="CHAVE DE ACESSO"
                                   Style="{StaticResource InfoValue}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TextLinkButton}"
                                ToolTip="Gerar chave criptográfica aleatória de alta entropia"
                                Click="GeneratePassword_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix"
                                                         Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                <TextBlock Text="Gerar senha forte"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Campo Senha -->
                    <PasswordBox x:Name="PasswordBox"
                                 materialDesign:HintAssist.Hint="Senha de Cifra (mínimo 10 caracteres)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignPasswordBox}"
                                 Margin="0,0,0,4"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <!-- Barra de força da senha suave e contínua -->
                    <Grid Margin="0,8,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Indicador de força de 3 segmentos arredondados -->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle Grid.Column="0"
                                       Style="{StaticResource StrengthBar}"
                                       x:Name="StrengthBar1"
                                       Fill="{DynamicResource StrengthEmptyBrush}" />
                            <Rectangle Grid.Column="2"
                                       Style="{StaticResource StrengthBar}"
                                       x:Name="StrengthBar2"
                                       Fill="{DynamicResource StrengthEmptyBrush}" />
                            <Rectangle Grid.Column="4"
                                       Style="{StaticResource StrengthBar}"
                                       x:Name="StrengthBar3"
                                       Fill="{DynamicResource StrengthEmptyBrush}" />
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   x:Name="StrengthLabel"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas, Courier New"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Campo Confirmação de Senha -->
                    <PasswordBox x:Name="ConfirmBox"
                                 materialDesign:HintAssist.Hint="Confirme a senha de cifra"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignPasswordBox}"
                                 Margin="0,0,0,4"
                                 PasswordChanged="ConfirmBox_PasswordChanged" />

                    <!-- Alerta de incompatibilidade -->
                    <Border x:Name="MismatchBorder"
                            CornerRadius="8"
                            Background="{DynamicResource LockedSoftBrush}"
                            Padding="10,6"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Foreground="{StaticResource LockedBrush}"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="As senhas de cifra não coincidem"
                                       Foreground="{StaticResource LockedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </materialDesign:Card>

            <!-- Alerta de Erro caso ocorra -->
            <Border x:Name="ErrorBorder"
                    Padding="14,10"
                    Background="{DynamicResource LockedSoftBrush}"
                    BorderBrush="{StaticResource LockedBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle"
                                             Foreground="{StaticResource LockedBrush}"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock x:Name="ErrorText"
                               Foreground="{StaticResource LockedBrush}"
                               TextWrapping="Wrap"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Ações -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryActionButton}"
                        Content="Cancelar"
                        Click="Cancel_Click"
                        HorizontalAlignment="Stretch" />

                <Button Grid.Column="2"
                        x:Name="LockConfirmButton"
                        Style="{StaticResource PrimaryActionButton}"
                        Click="LockConfirm_Click"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockPattern"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Ativar Ofuscação" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ── FASE 2: SUCESSO & CHAVE DE BYPASS (ShowRecoveryKey) ──────── -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <StackPanel Visibility="{Binding ShowRecoveryKey, Converter={StaticResource BoolToVis}}">

            <!-- Banner suave de sucesso com tom cyber -->
            <Border Background="{DynamicResource UnlockedSoftBrush}"
                    BorderBrush="{StaticResource UnlockedBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="CheckDecagram"
                                             Width="28" Height="28"
                                             Foreground="{StaticResource UnlockedBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Payload Ofuscado com Sucesso!"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{StaticResource UnlockedBrush}" />
                        <TextBlock Text="Arquivos criptografados e convertidos para formato binário .tmx"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card da Chave Mestra de Bypass -->
            <materialDesign:Card UniformCornerRadius="18"
                                 Padding="20"
                                 Margin="0,0,0,20"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="KeyChain"
                                                 Width="22" Height="22"
                                                 Foreground="{DynamicResource CyberCyanBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Chave Mestra de Bypass"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,0,0,14"
                               FontSize="12.5">
                        Guarde esta chave em local seguro <Bold>fora deste host</Bold>. Se você esquecer sua senha, este token de bypass será o <Bold>único vetor</Bold> para reverter a ofuscação dos dados.
                    </TextBlock>

                    <!-- Caixa da chave -->
                    <Border Style="{StaticResource RecoveryKeyBox}"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding RecoveryKey}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Botão Copiar Chave -->
                    <Button Style="{StaticResource SecondaryActionButton}"
                            x:Name="CopyKeyButton"
                            HorizontalAlignment="Stretch"
                            Click="CopyKey_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="CopyKeyIcon"
                                                     Kind="ContentCopy"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="CopyKeyLabel"
                                       Text="Copiar Chave Mestra para Clipboard"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </materialDesign:Card>

            <!-- Aviso opcional de backup -->
            <Border Background="{DynamicResource InconsistentSoftBrush}"
                    BorderBrush="{StaticResource InconsistentBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,10"
                    Margin="0,0,0,20"
                    Visibility="{Binding BackupWarning, Converter={StaticResource NullOrEmptyToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOutline"
                                             Width="20" Height="20"
                                             VerticalAlignment="Top"
                                             Margin="0,2,10,0"
                                             Foreground="{StaticResource InconsistentBrush}" />
                    <TextBlock Text="{Binding BackupWarning}"
                               Foreground="{StaticResource InconsistentBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Botão de Conclusão -->
            <Button Style="{StaticResource PrimaryActionButton}"
                    Content="Concluir e Proteger Payload"
                    Click="Close_Click"
                    HorizontalAlignment="Stretch" />

        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ── OVERLAY DE PROGRESSO SUAVE ───────────────────────────────── -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="BusyOverlay"
                Background="#CC000000"
                CornerRadius="16"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="48" Height="48"
                             Foreground="{DynamicResource CyberCyanBrush}" />
                <TextBlock Text="Executando cifragem e ofuscação do payload..."
                           Foreground="White"
                           FontWeight="Medium"
                           FontFamily="Consolas, Courier New"
                           FontSize="13.5"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Criptografia AES-256 GCM em andamento"
                           Foreground="#AAFFFFFF"
                           FontFamily="Consolas, Courier New"
                           FontSize="11"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
