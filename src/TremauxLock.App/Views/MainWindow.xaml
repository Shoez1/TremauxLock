<Window x:Class="TremauxLock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:TremauxLock.App.Converters"
        mc:Ignorable="d"
        Title="TremauxLockPro // Ofuscador Criptográfico"
        MinWidth="460" MinHeight="620"
        Width="460" Height="630"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header Estilo Hacking Suave -->
            <RowDefinition Height="*" />     <!-- Conteudo -->
            <RowDefinition Height="Auto" />  <!-- Footer Terminal Info -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER CIBERNÉTICO SUAVE ═════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="22,16,22,14"
                Background="{DynamicResource MaterialDesign.Brush.Surface}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand com badge circular e visual hacking -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40"
                            CornerRadius="20"
                            Background="{DynamicResource CyberCyanSoftBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ShieldBugOutline"
                                                 Width="22" Height="22"
                                                 Foreground="{DynamicResource CyberCyanBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TremauxLockPro"
                                       FontWeight="Bold"
                                       FontSize="17" />
                            <Border Margin="8,0,0,0"
                                    Background="{DynamicResource CyberCyanSoftBrush}"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v3.1 // CORE"
                                           FontSize="10"
                                           FontFamily="Consolas, Courier New"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource CyberCyanBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Ofuscador Criptográfico de Arquivos"
                                   Style="{StaticResource InfoLabel}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Ações do header -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="Verificar integridade do payload"
                            Width="36" Height="36"
                            materialDesign:ButtonAssist.CornerRadius="18">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ CONTEÚDO PRINCIPAL ════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="22,18">
            <StackPanel>

                <!-- ── HERO CARD DE STATUS ─────────────────────────────────── -->
                <materialDesign:Card Style="{StaticResource VaultStatusCard}"
                                     x:Name="HeroCard">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Linha de Status com Badge Pill Suave -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Badge Pill do Status com tipografia técnica -->
                            <Border x:Name="StatusPillBorder"
                                    Style="{StaticResource StatusPill}"
                                    Background="{DynamicResource UnlockedSoftBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDotEllipse"
                                             Style="{StaticResource StatusDot}"
                                             Fill="{StaticResource UnlockedBrush}" />
                                    <TextBlock x:Name="StatusTextBlock"
                                               Text="{Binding StatusText}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               FontFamily="Consolas, Courier New" />
                                </StackPanel>
                            </Border>

                            <!-- Ícone ilustrativo suave no canto direito -->
                            <materialDesign:PackIcon Grid.Column="1"
                                                     x:Name="HeroStatusIcon"
                                                     Kind="CodeJson"
                                                     Width="30" Height="30"
                                                     Opacity="0.4"
                                                     VerticalAlignment="Center" />
                        </Grid>

                        <!-- Descrição técnica de estado -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding StatusSubtext}"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Grid>
                </materialDesign:Card>

                <!-- ── MÉTRICAS DO PAYLOAD (quando há arquivos) ─────────────── -->
                <Grid Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"
                      Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card Arquivos / Itens -->
                    <materialDesign:Card Grid.Column="0"
                                         Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="FileCodeOutline"
                                                         Width="16" Height="16"
                                                         Opacity="0.6"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                <TextBlock Text="ITENS CARREGADOS"
                                           Style="{StaticResource InfoLabel}"
                                           FontFamily="Consolas, Courier New"
                                           FontSize="10.5" />
                            </StackPanel>
                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} arquivo(s)'}"
                                       Style="{StaticResource InfoValue}"
                                       FontSize="15" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card Tamanho Total -->
                    <materialDesign:Card Grid.Column="2"
                                         Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="Memory"
                                                         Width="16" Height="16"
                                                         Opacity="0.6"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                <TextBlock Text="VOLUME TOTAL"
                                           Style="{StaticResource InfoLabel}"
                                           FontFamily="Consolas, Courier New"
                                           FontSize="10.5" />
                            </StackPanel>
                            <TextBlock Text="{Binding TotalSize}"
                                       Style="{StaticResource InfoValue}"
                                       FontSize="15" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- Card de Data da Ofuscação (visível quando ativo) -->
                <materialDesign:Card Margin="0,0,0,20"
                                     Style="{StaticResource MetricCard}"
                                     Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OFUSCADO EM"
                                       Style="{StaticResource InfoLabel}"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="10.5" />
                            <TextBlock Text="{Binding LockedAt}"
                                       Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="ClockTimeEightOutline"
                                                 Width="22" Height="22"
                                                 Opacity="0.4"
                                                 VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>

                <!-- ── ESTADO STANDBY // VAZIO ─────────────────────────────── -->
                <Border Padding="24,20"
                        Margin="0,0,0,20"
                        Background="{DynamicResource EmptySoftBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56"
                                CornerRadius="28"
                                Background="{DynamicResource MaterialDesign.Brush.Surface}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FolderArrowUpOutline"
                                                     Width="28" Height="28"
                                                     Foreground="{DynamicResource EmptyBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Diretório private pronto para ingestão"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Deposite os arquivos que deseja ofuscar dentro da pasta e execute a ofuscação criptográfica."
                                   Style="{StaticResource SubtitleText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ── ESTADO INCONSISTENTE ─────────────────────────────────── -->
                <Border Margin="0,0,0,20"
                        Padding="16,14"
                        CornerRadius="16"
                        Background="{DynamicResource InconsistentSoftBrush}"
                        BorderBrush="{StaticResource InconsistentBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsInconsistent, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertDecagramOutline"
                                                 Width="22" Height="22"
                                                 Foreground="{StaticResource InconsistentBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <TextBlock Text="Anomalia detectada: discrepância entre arquivos criptografados e metadados. Verifique a integridade do diretório."
                                   Foreground="{StaticResource InconsistentBrush}"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ── AÇÕES CONTEXTUAIS ───────────────────────────────────── -->

                <!-- Ações para PAYLOAD DESOFUSCADO (com arquivos) -->
                <StackPanel Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryActionButton}"
                            x:Name="LockButton"
                            Click="LockButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockPattern"
                                                     Width="19" Height="19"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Ofuscar e Criptografar Arquivos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding OpenFolderCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Explorar Pasta de Trabalho (private)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Ações para STANDBY (vazio) -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryActionButton}"
                            x:Name="OpenFolderEmptyButton"
                            Click="OpenFolderEmpty_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                     Width="19" Height="19"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Abrir Pasta de Trabalho (private)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionButton}"
                            x:Name="LockEmptyButton"
                            Click="LockButton_Click"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockPattern"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Ofuscar Diretório Vazio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Ações para OFUSCAÇÃO ATIVA (bloqueado) -->
                <StackPanel Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryActionButton}"
                            x:Name="UnlockButton"
                            Click="UnlockButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyVariant"
                                                     Width="19" Height="19"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Desofuscar com Senha" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionButton}"
                            x:Name="RecoveryButton"
                            Click="RecoveryButton_Click"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldKeyOutline"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Bypass com Chave Mestra" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Mensagem de Erro Geral -->
                <Border Margin="0,16,0,0"
                        Padding="14,10"
                        Background="{DynamicResource LockedSoftBrush}"
                        BorderBrush="{StaticResource LockedBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource LockedBrush}"
                               FontWeight="Medium"
                               TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ FOOTER TÉCNICO TERMINAL ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Padding="22,10"
                Background="{DynamicResource MaterialDesign.Brush.Surface}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding WorkingFolderPath, StringFormat='TARGET: {0}'}"
                           Style="{StaticResource InfoLabel}"
                           FontFamily="Consolas, Courier New"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="CIPHER: AES-256-GCM"
                           Style="{StaticResource InfoLabel}"
                           FontFamily="Consolas, Courier New"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource CyberCyanBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ══ OVERLAY DE CARREGAMENTO ═══════════════════════════════════════ -->
        <Border Grid.RowSpan="3"
                Background="#CC000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="48" Height="48"
                             Foreground="{DynamicResource CyberCyanBrush}" />
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="White"
                           FontWeight="Medium"
                           FontFamily="Consolas, Courier New"
                           FontSize="13"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
