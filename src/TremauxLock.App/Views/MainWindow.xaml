<Window x:Class="TremauxLock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:TremauxLock.App.ViewModels"
        mc:Ignorable="d"
        Title="TremauxLock"
        MinWidth="440" MinHeight="580"
        Width="440" Height="580"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <!-- State → brush converters defined in code-behind -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="*" />     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══ Header ════════════════════════════════════════════════════════ -->
        <materialDesign:ColorZone Mode="PrimaryMid"
                                   Padding="20,14"
                                   Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Shield"
                                            Width="24" Height="24"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                    <TextBlock Text="TremauxLock"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        ToolTip="Atualizar status"
                        Foreground="White">
                    <materialDesign:PackIcon Kind="Refresh" />
                </Button>
            </Grid>
        </materialDesign:ColorZone>

        <!-- ══ Content ═══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">
            <StackPanel>

                <!-- Status Card -->
                <materialDesign:Card Style="{StaticResource VaultStatusCard}"
                                     x:Name="StatusCard">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Status header row -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Grid.Row="0">
                            <Ellipse Style="{StaticResource StatusDot}"
                                     x:Name="StatusDotEllipse" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusText}" />
                        </StackPanel>

                        <!-- Status description -->
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource SubtitleText}"
                                   Text="{Binding StatusSubtext}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </materialDesign:Card>

                <!-- Info rows: visible when locked or unlocked -->
                <materialDesign:Card Margin="0,0,0,16"
                                     Padding="20"
                                     UniformCornerRadius="12"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis},
                                                  ConverterParameter=inverse}">
                    <StackPanel>

                        <!-- File count -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Arquivos" />
                                <TextBlock Style="{StaticResource InfoValue}"
                                           Text="{Binding FileCount, StringFormat='{}{0} arquivo(s)'}" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1"
                                                     Kind="FolderMultiple"
                                                     Width="28" Height="28"
                                                     VerticalAlignment="Center"
                                                     Opacity="0.4" />
                        </Grid>

                        <Separator Opacity="0.15" Margin="0,0,0,12" />

                        <!-- Total size -->
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Tamanho total" />
                                <TextBlock Style="{StaticResource InfoValue}"
                                           Text="{Binding TotalSize}" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1"
                                                     Kind="Database"
                                                     Width="28" Height="28"
                                                     VerticalAlignment="Center"
                                                     Opacity="0.4" />
                        </Grid>

                        <!-- Locked-at (only when locked) -->
                        <Grid Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Bloqueado em" />
                                <TextBlock Style="{StaticResource InfoValue}"
                                           Text="{Binding LockedAt}" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1"
                                                     Kind="ClockOutline"
                                                     Width="28" Height="28"
                                                     VerticalAlignment="Center"
                                                     Opacity="0.4" />
                        </Grid>

                    </StackPanel>
                </materialDesign:Card>

                <!-- Empty state hint -->
                <Border Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                 Width="64" Height="64"
                                                 HorizontalAlignment="Center"
                                                 Opacity="0.25"
                                                 Margin="0,0,0,12" />
                        <TextBlock Text="Pasta private está vazia"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5" />
                        <TextBlock Text="Adicione arquivos e clique em Bloquear Cofre"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Inconsistent warning -->
                <materialDesign:Card Margin="0,0,0,16"
                                     Padding="16"
                                     UniformCornerRadius="12"
                                     Background="{DynamicResource MaterialDesign.Brush.Secondary}"
                                     Visibility="{Binding IsInconsistent, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline"
                                                 Width="24" Height="24"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <TextBlock Text="O cofre está em estado inconsistente. Verifique a pasta do app."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- ── Actions ────────────────────────────────────────── -->

                <!-- Unlocked actions: Lock + Open Folder -->
                <StackPanel Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryActionButton}"
                            x:Name="LockButton"
                            Click="LockButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOutline"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Bloquear Cofre" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding OpenFolderCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Abrir Pasta Private" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Empty actions: Lock (to create) -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SecondaryActionButton}"
                            x:Name="OpenFolderEmptyButton"
                            Click="OpenFolderEmpty_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Abrir Pasta Private" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryActionButton}"
                            x:Name="LockEmptyButton"
                            Click="LockButton_Click"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOutline"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Bloquear Cofre" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Locked actions: Unlock with password or recovery key -->
                <StackPanel Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryActionButton}"
                            x:Name="UnlockButton"
                            Click="UnlockButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOpenOutline"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Desbloquear com Senha" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionButton}"
                            x:Name="RecoveryButton"
                            Click="RecoveryButton_Click"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Key"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Usar Chave de Recuperação" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Error snackbar area -->
                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="#B71C1C"
                        CornerRadius="8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="White"
                               TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay -->
        <Grid Grid.RowSpan="2"
              Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="48" Height="48" />
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="White"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
