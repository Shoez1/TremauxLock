<Window x:Class="TremauxLock.App.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Desbloquear Cofre"
        Width="440" SizeToContent="Height"
        MinHeight="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <StackPanel Margin="28,24">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="LockOpenOutline"
                                     Width="28" Height="28"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     Margin="0,0,10,0" />
            <TextBlock x:Name="TitleBlock"
                       Text="Desbloquear Cofre"
                       Style="{StaticResource PageTitle}" />
        </StackPanel>
        <TextBlock x:Name="SubtitleBlock"
                   Text="Digite sua senha para acessar os arquivos."
                   Style="{StaticResource SubtitleText}"
                   Margin="0,0,0,24" />

        <!-- Password entry (shown when not using recovery key) -->
        <PasswordBox x:Name="PasswordBox"
                     materialDesign:HintAssist.Hint="Senha do cofre"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignPasswordBox}"
                     Margin="0,0,0,16"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     KeyDown="PasswordBox_KeyDown" />

        <!-- Recovery key entry (shown when using recovery key) -->
        <TextBox x:Name="RecoveryBox"
                 materialDesign:HintAssist.Hint="Chave de recuperação (XXXX-XXXX-...)"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignTextBox}"
                 FontFamily="Consolas, Courier New"
                 Visibility="Collapsed"
                 Margin="0,0,0,16"
                 TextChanged="RecoveryBox_TextChanged"
                 KeyDown="RecoveryBox_KeyDown" />

        <!-- Toggle mode link -->
        <Button x:Name="ToggleModeButton"
                Style="{StaticResource TextLinkButton}"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"
                Click="ToggleMode_Click"
                Content="Usar chave de recuperação" />

        <!-- Error message -->
        <Border x:Name="ErrorBorder"
                Padding="12,8"
                Background="#B71C1C"
                CornerRadius="6"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                         VerticalAlignment="Center"
                                         Foreground="White"
                                         Margin="0,0,8,0" />
                <TextBlock x:Name="ErrorText"
                           Foreground="White"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Success message -->
        <Border x:Name="SuccessBorder"
                Padding="12,8"
                Background="#1B5E20"
                CornerRadius="6"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircle"
                                         VerticalAlignment="Center"
                                         Foreground="#A5D6A7"
                                         Margin="0,0,8,0" />
                <TextBlock Text="Cofre desbloqueado com sucesso!"
                           Foreground="#A5D6A7"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Busy indicator -->
        <StackPanel x:Name="BusyPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Width="28" Height="28"
                         Margin="0,0,12,0" />
            <TextBlock Text="Descriptografando..."
                       VerticalAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Action buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryActionButton}"
                    Content="Cancelar"
                    Click="Cancel_Click"
                    HorizontalAlignment="Stretch" />

            <Button Grid.Column="2"
                    x:Name="UnlockButton"
                    Style="{StaticResource PrimaryActionButton}"
                    Click="Unlock_Click"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LockOpenOutline"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                    <TextBlock Text="Desbloquear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

    </StackPanel>
</Window>
