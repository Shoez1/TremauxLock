<Window x:Class="TremauxLock.App.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:TremauxLock.App.Converters"
        Title="TremauxLockPro // Desofuscação de Dados"
        Width="460" SizeToContent="Height"
        MinHeight="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
    </Window.Resources>

    <Grid Margin="24,20,24,24">

        <StackPanel>

            <!-- Header com badge circular e título -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource CyberCyanSoftBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ShieldKeyOutline"
                                             Width="24" Height="24"
                                             Foreground="{DynamicResource CyberCyanBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock"
                               Text="Desofuscar Payload"
                               Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="SubtitleBlock"
                               Text="Autentique com a chave para descriptografar os dados"
                               Style="{StaticResource SubtitleText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Alternador estilo Pill Tab (Senha vs Chave Bypass) -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Surface.Variant}"
                    CornerRadius="16"
                    Padding="4"
                    Margin="0,0,0,18"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Botão Tab Senha -->
                    <Button x:Name="TabPasswordButton"
                            Grid.Column="0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="38"
                            materialDesign:ButtonAssist.CornerRadius="14"
                            Click="TabPassword_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyVariant"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="Senha de Cifra"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botão Tab Chave Mestra Bypass -->
                    <Button x:Name="TabRecoveryButton"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="38"
                            materialDesign:ButtonAssist.CornerRadius="14"
                            Click="TabRecovery_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyChain"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="Chave Bypass"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Card dos campos de entrada -->
            <materialDesign:Card UniformCornerRadius="18"
                                 Padding="20"
                                 Margin="0,0,0,16"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>

                    <!-- Entrada de Senha -->
                    <StackPanel x:Name="PasswordPanel">
                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="Digite a senha de cifra"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignPasswordBox}"
                                     FontSize="14"
                                     Margin="0,0,0,4"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     KeyDown="PasswordBox_KeyDown" />
                    </StackPanel>

                    <!-- Entrada de Chave Mestra de Bypass -->
                    <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
                        <TextBox x:Name="RecoveryBox"
                                 materialDesign:HintAssist.Hint="Token de Bypass (XXXX-XXXX-...)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="13.5"
                                 Margin="0,0,0,4"
                                 TextChanged="RecoveryBox_TextChanged"
                                 KeyDown="RecoveryBox_KeyDown" />
                        <TextBlock Text="Cole o token mestre de 32 caracteres gerado no momento da ofuscação"
                                   Style="{StaticResource InfoLabel}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                </StackPanel>
            </materialDesign:Card>

            <!-- Mensagem de Erro com cantos suaves -->
            <Border x:Name="ErrorBorder"
                    Padding="14,10"
                    Background="{DynamicResource LockedSoftBrush}"
                    BorderBrush="{StaticResource LockedBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="AlertDecagramOutline"
                                             Width="20" Height="20"
                                             Foreground="{StaticResource LockedBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               x:Name="ErrorText"
                               Foreground="{StaticResource LockedBrush}"
                               TextWrapping="Wrap"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Banner de Sucesso com cantos suaves -->
            <Border x:Name="SuccessBorder"
                    Padding="14,10"
                    Background="{DynamicResource UnlockedSoftBrush}"
                    BorderBrush="{StaticResource UnlockedBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckDecagram"
                                             Foreground="{StaticResource UnlockedBrush}"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                    <TextBlock Text="Payload desofuscado e restaurado com sucesso!"
                               Foreground="{StaticResource UnlockedBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Indicador de progresso ocupado -->
            <StackPanel x:Name="BusyPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="24" Height="24"
                             Foreground="{DynamicResource CyberCyanBrush}"
                             Margin="0,0,12,0" />
                <TextBlock Text="Validando hash e descriptografando payload..."
                           VerticalAlignment="Center"
                           FontFamily="Consolas, Courier New"
                           FontWeight="Medium"
                           Opacity="0.85" />
            </StackPanel>

            <!-- Ações -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryActionButton}"
                        Content="Cancelar"
                        Click="Cancel_Click"
                        HorizontalAlignment="Stretch" />

                <Button Grid.Column="2"
                        x:Name="UnlockButton"
                        Style="{StaticResource PrimaryActionButton}"
                        Click="Unlock_Click"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldKeyOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Desofuscar Payload" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>

    </Grid>
</Window>
