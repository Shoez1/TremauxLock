<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TremauxLock.App</RootNamespace>
    <AssemblyName>TremauxLockPro</AssemblyName>
    <ApplicationIcon>..\..\ladybug.ico</ApplicationIcon>
    <AssemblyTitle>TremauxLockPro</AssemblyTitle>
    <Product>TremauxLockPro</Product>
    <Copyright>TremauxLockPro</Copyright>

    <!-- Publicação: 100% Single File Portable (zero DLLs soltas) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TremauxLock.Core\TremauxLock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\ladybug.ico">
      <Link>ladybug.ico</Link>
    </Resource>
  </ItemGroup>

</Project>
